{
  "name": "bestaff-mobile-app",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "build": "expo export --output-dir ./build --platform all",
    "prebuild": "expo prebuild --clean",
    "android": "expo run:android",
    "android:prod": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:prod": "expo run:ios --scheme release",
    "start:dev-client": "expo start --dev-client",
    "start:prod": "expo start --dev-client --no-dev --minify",
    "export": "expo export",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll",
    "e2e": "sh ./scripts/e2e-run.sh",
    "web": "expo start --web",
    "fix-deps": "npx expo install --check",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "check-types": "tsc --noEmit",
    "postinstall": "patch-package",
    "clean": "rm -rf node_modules .expo"
  },
  "dependencies": {
    "@bestaff/ui": "workspace:*",
    "@expo/vector-icons": "catalog:expo54",
    "@gorhom/bottom-sheet": "catalog:third-party",
    "@gorhom/portal": "catalog:third-party",
    "@hookform/resolvers": "catalog:third-party",
    "@react-native-async-storage/async-storage": "catalog:third-party",
    "@react-navigation/bottom-tabs": "catalog:react-navigation",
    "@react-navigation/elements": "catalog:react-navigation",
    "@react-navigation/native": "catalog:react-navigation",
    "@tanstack/react-query": "catalog:third-party",
    "expo": "catalog:expo54",
    "expo-blur": "catalog:expo54",
    "expo-constants": "catalog:expo54",
    "expo-font": "catalog:expo54",
    "expo-haptics": "catalog:expo54",
    "expo-image": "catalog:expo54",
    "expo-linking": "catalog:expo54",
    "expo-localization": "catalog:expo54",
    "expo-notifications": "catalog:expo54",
    "expo-router": "catalog:expo54",
    "expo-secure-store": "catalog:expo54",
    "expo-splash-screen": "catalog:expo54",
    "expo-status-bar": "catalog:expo54",
    "expo-symbols": "catalog:expo54",
    "expo-system-ui": "catalog:expo54",
    "expo-web-browser": "catalog:expo54",
    "patch-package": "catalog:third-party",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-i18next": "catalog:third-party",
    "react-native": "catalog:react-native",
    "react-native-gesture-handler": "catalog:react-native",
    "react-native-reanimated": "catalog:react-native",
    "react-native-safe-area-context": "catalog:react-native",
    "react-native-screens": "catalog:react-native",
    "react-native-web": "catalog:react-native",
    "react-native-webview": "catalog:react-native",
    "react-native-worklets": "catalog:react-native",
    "zod": "catalog:third-party"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@bestaff/eslint-config": "workspace:*",
    "@bestaff/prettier-config": "workspace:*",
    "@bestaff/typescript-config": "workspace:*",
    "@testing-library/react-native": "catalog:testing",
    "@types/jest": "catalog:testing",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "eslint-config-expo": "catalog:eslint-plugins",
    "jest": "catalog:testing",
    "jest-expo": "catalog:testing",
    "typescript": "catalog:"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  }
}
